    "pr:body-check": "node scripts/pr-body-check.mjs",
    "pr:preflight": "node scripts/pr-preflight.mjs",
    "pr:preflight:run": "node scripts/pr-preflight.mjs --run",
    "pr:test": "node --test scripts/__tests__/pr-body-check.test.mjs scripts/__tests__/pr-preflight.test.mjs scripts/__tests__/governance-policy.test.mjs scripts/__tests__/vercel-ignore-command.test.mjs scripts/__tests__/rc-smoke-contract.test.mjs scripts/__tests__/beta-evidence.test.mjs scripts/__tests__/connection-matrix.test.mjs scripts/__tests__/staging-repair.test.mjs scripts/__tests__/merge-queue.test.mjs tests/playwright/target.test.mjs scripts/__tests__/playwright-agent-evidence.test.mjs",
