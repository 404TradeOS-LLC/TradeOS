# Copy this file to .env.local and fill in real values. Never commit .env* files.
#
# This is a SEPARATE Vercel project from the backend ("tradeos-costbook").
# Variables here must be set on the web/ frontend Vercel project — setting
# them on the backend project (which never reads any of these) does nothing.

# --- Supabase (auth session + Storage) -------------------------------------
# Same Supabase project the backend's RLS-aware auth already trusts. Both
# vars below are read with a non-null assertion (`!`) in
# src/lib/supabase/server.ts and src/lib/supabase/proxy.ts. proxy.ts's
# updateSession runs on /dashboard, /customers, /projects, and /dispatch
# requests (see proxy.ts's matcher). Every route in src/app/(app) also checks
# the session in its server layout. If either value is missing, authenticated
# routes cannot establish a Supabase session.
#
# Browser-visible (NEXT_PUBLIC_ prefix) — safe to expose. Supabase's
# publishable/anon key is designed to be public; access control is enforced
# by Supabase RLS policies, not by keeping this key secret.
#
# Configure values independently for Vercel Preview and Production. Prefer an
# isolated Supabase project/branch for Preview. If Preview intentionally uses
# production dependencies, keep testing non-destructive and approval-gated.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="replace-with-supabase-anon-or-publishable-key"

# Server-only. Never put a secret in a NEXT_PUBLIC_-prefixed variable, and
# never reference this from a Client Component — the "server-only" import
# guard in src/lib/supabase/admin.ts throws a build error if that ever
# happens by accident.
#
# Bypasses Supabase Storage RLS entirely (service_role). Only
# src/lib/supabase/admin.ts reads it (guarded by `import "server-only"`);
# authorization for anything that uses this client is enforced by the
# calling Server Action's own permission checks, not by Storage policies.
# Required for createSupabaseAdminClient(). It throws an explicit error if
# unset when a privileged Brand Studio asset upload/remove action invokes it.
#
# NOTE: this key belongs to whichever Supabase project NEXT_PUBLIC_SUPABASE_URL
# points at for the SAME environment — set both together per environment,
# never mix keys/URLs from different Supabase projects.
SUPABASE_SERVICE_ROLE_KEY="replace-with-supabase-service-role-secret-key"

# --- Supabase Storage bucket configuration ----------------------------------
# Browser-visible (NEXT_PUBLIC_ prefix) — a bucket name is not sensitive.
# Optional: defaults to "project-files" if unset (src/lib/storage.ts,
# src/app/actions/projects.ts). If your real bucket has a different name
# and this is left unset, uploads/downloads will silently target a bucket
# that may not exist — verify this matches the bucket you actually created.
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET="project-files"

# Server-only, never reference from a Client Component. Optional: defaults
# to "true" if unset. Must match the bucket's ACTUAL public/private setting
# in the Supabase dashboard — getting this wrong does not crash anything,
# it silently produces broken (public URLs for a private bucket) or
# unnecessarily-expiring (signed URLs for a public bucket) links. Set to
# "false" to force server-rendered pages to use signed URLs instead.
SUPABASE_STORAGE_BUCKET_PUBLIC="true"

# --- Backend API ------------------------------------------------------------
# Server-only, never reference from a Client Component (Client Components
# call the same-origin /api/proxy/* and /api/documents/* route handlers
# instead — see src/lib/clientApi.ts — so the backend origin and the
# session's bearer token never reach browser JS).
#
# Optional: defaults to "http://localhost:4000" if unset — correct for
# local dev only. In Preview/Production this MUST point at the deployed
# backend ("tradeos-costbook" Vercel project's) URL; there is no fail-closed
# check here, so leaving this unset in a deployed environment does not
# crash the app at startup — every backend-dependent page/action will just
# fail at request time trying to reach localhost from a serverless function.
BACKEND_API_URL="http://localhost:4000"

# --- Build metadata (informational only, do not set manually) ---------------
# Auto-injected by Vercel's platform when the project's "Automatically
# expose System Environment Variables" setting is enabled — not something to
# fill in above. Both are optional and already fall back gracefully
# (src/app/(app)/settings/page.tsx) to "local-dev" / a hardcoded placeholder
# build number when absent, so local dev without Vercel-linked env is fine.
# VERCEL_GIT_COMMIT_SHA=""
# NEXT_PUBLIC_VERCEL_GIT_COMMIT_SHA=""
