{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "express",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true,
      "staging": true
    }
  },
  "ignoreCommand": "sh vercel-ignore-build.sh",
  "functions": {
    "index.ts": {
      "includeFiles": "{vendor/knowledge-engine/**,node_modules/pdfkit/js/standard-fonts/**}"
    }
  },
  "crons": [
    {
      "path": "/api/cron/supplier-price-sync",
      "schedule": "0 12 * * *"
    }
  ]
}
