{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "express",
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  },
  "ignoreCommand": "git cat-file -e \"$VERCEL_GIT_PREVIOUS_SHA^{commit}\" 2>/dev/null || exit 1; git diff --quiet \"$VERCEL_GIT_PREVIOUS_SHA\" \"$VERCEL_GIT_COMMIT_SHA\" -- ':(top)app/**' ':(top)packages/knowledge-engine/**'",
  "functions": {
    "index.ts": {
      "includeFiles": "vendor/knowledge-engine/**"
    }
  }
}
