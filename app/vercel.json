{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "express",
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  },
  "ignoreCommand": "[ -n \"$VERCEL_GIT_PREVIOUS_SHA\" ] && [ -n \"$VERCEL_GIT_COMMIT_SHA\" ] && git cat-file -e \"$VERCEL_GIT_PREVIOUS_SHA\" 2>/dev/null && git diff --quiet \"$VERCEL_GIT_PREVIOUS_SHA\" \"$VERCEL_GIT_COMMIT_SHA\" -- ':(top)app/**'",
  "functions": {
    "index.ts": {
      "includeFiles": "vendor/knowledge-engine/**"
    }
  }
}
