# Copy this file to .env and fill in real values. Never commit .env.

# Postgres/Supabase connection string used by Prisma at runtime — the
# restricted application role (see scripts/provision-app-role.sh), never the
# database superuser/owner. Vercel/serverless deployments using the Supabase
# shared pooler must use transaction mode (port 6543) with
# `pgbouncer=true&connection_limit=1&sslmode=require`. The runtime also
# enforces those bounded pooling and encrypted-transport settings for Supabase
# pooler URLs on Vercel so a stale port-5432 session-mode URL cannot exhaust
# the shared session pool or permit cleartext database transport. Do not set
# `sslaccept=strict` until the runtime trusts the Supabase pooler's certificate
# chain; Vercel otherwise rejects the current chain and database readiness fails.
DATABASE_URL="postgresql://tradeos_app:replace-me@localhost:5432/tradeos_costbook?schema=public"

# Elevated connection string used ONLY by scripts/deploy-migrations.sh and
# scripts/provision-app-role.sh. Migrations include forced-RLS/policy DDL
# the restricted application role is never granted permission to run, and
# that role cannot grant privileges to itself. Never use this as DATABASE_URL.
DATABASE_ADMIN_URL="postgresql://postgres:password@localhost:5432/tradeos_costbook?schema=public"

# Password for the restricted application role that scripts/deploy-migrations.sh
# / scripts/provision-app-role.sh will create or update. Required for those
# scripts to provision the role; not read by the running API itself (it just
# uses DATABASE_URL). Rotate independently of DATABASE_ADMIN_URL's credentials.
APP_DB_ROLE_PASSWORD="replace-with-a-real-secret"
# Defaults to "tradeos_app" if unset.
APP_DB_ROLE_NAME=""

# Port the API server listens on.
PORT=4000

# Proxy handling for deployments behind a load balancer or platform proxy.
# Controls Express's `trust proxy` setting (backend/server.ts), which governs
# how much of the X-Forwarded-For header express-rate-limit and req.ip trust.
# Examples: "true" (trust every hop — DO NOT use, lets a client spoof its own
# IP and bypass rate limiting), "1" (trust exactly one hop), "loopback",
# "10.0.0.0/8".
#
# Vercel Production/Preview: set TRUST_PROXY="1". Vercel's serverless
# functions sit behind exactly one hop of Vercel's own edge proxy, which
# appends the real client IP as the last entry of X-Forwarded-For — "1"
# trusts only that single innermost entry and ignores anything a client
# prepends earlier in the header. See
# https://express-rate-limit.github.io/ERR_ERL_UNEXPECTED_X_FORWARDED_FOR/
#
# Local development / no reverse proxy in front: leave unset (defaults to
# "false"), so an X-Forwarded-For header a test sends manually is never
# trusted.
TRUST_PROXY="false"

# Enable HSTS only when the app is always served over HTTPS in production.
ENABLE_STRICT_TRANSPORT_SECURITY="false"

# CORS is allowlist-based (backend/middleware/productionHardening.ts):
# https://app.404tradeos.com, any tradeos-costbook-web Vercel Preview
# deployment (https://tradeos-costbook-web-*.vercel.app), and localhost are
# always allowed. Use this to extend the allowlist without a code change,
# e.g. for a staging domain — comma-separated, no wildcards.
CORS_ADDITIONAL_ORIGINS=""

# Secret used to verify and sign bearer JWTs in local development and self-hosted deployments.
AUTH_JWT_SECRET="replace-me"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_JWT_ISSUER=""
SUPABASE_JWT_JWKS_URL=""
SUPABASE_JWT_AUDIENCE=""

# Optional auth settings.
AUTH_ISSUER="tradeos-costbook"
AUTH_AUDIENCE="tradeos-costbook-api"
# Lifetime for locally issued HS256 access tokens. Defaults to one hour.
AUTH_JWT_TTL_SECONDS=3600

# Rate limit for POST/authentication routes guarded by authRateLimit.ts.
# Defaults to 20 requests per 15 minutes per client IP if unset.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# Server-side transactional email through Resend. Never expose the API key in
# NEXT_PUBLIC_* variables or browser code. The sender domain must be verified
# in Resend before production sends are enabled.
RESEND_API_KEY=""
EMAIL_FROM="TradeOS <hello@404tradeos.com>"
# Public web origin used to construct password-reset and team-invite links.
APP_BASE_URL="http://localhost:3000"

# Rate limit for AI Estimate Assist routes guarded by aiEstimateRateLimit.ts.
# Defaults to 30 requests per 5 minutes per client IP if unset.
AI_ESTIMATE_RATE_LIMIT_WINDOW_MS=300000
AI_ESTIMATE_RATE_LIMIT_MAX=30

# Secret used to sign/verify AI Estimator apply-review tokens
# (modules/ai-estimate-assist/structuredEstimator.ts). Falls back to
# AUTH_JWT_SECRET when unset, so this is only needed to use a distinct
# secret; in production, one of the two must be set or token signing fails.
# Token lifetime defaults to 24 hours; override in milliseconds.
AI_ESTIMATOR_REVIEW_TOKEN_SECRET=""
AI_ESTIMATOR_REVIEW_TOKEN_TTL_MS=86400000

# One-shot local/production admin bootstrap. The command is inert unless
# BOOTSTRAP_ADMIN_ENABLED is exactly "true". The password must be at least
# 14 characters and must be stored only in secret/environment storage.
# The command uses DATABASE_ADMIN_URL intentionally because tenant RLS prevents
# cross-tenant organization discovery through the restricted runtime role.
# Run: npm run admin:bootstrap
# After verifying login, set BOOTSTRAP_ADMIN_ENABLED back to "false".
BOOTSTRAP_ADMIN_ENABLED="false"
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""
BOOTSTRAP_ADMIN_NAME=""
BOOTSTRAP_ADMIN_ORG_NAME=""
# Allowed values: admin, owner. Defaults to admin when blank/unset.
BOOTSTRAP_ADMIN_ROLE="admin"

# Maximum lifetime for the request transaction that carries RLS session state.
RLS_TRANSACTION_TIMEOUT_MS=60000
# Maximum time a request may wait to acquire a Prisma transaction. This must
# exceed Prisma's 2-second default when a serverless instance uses the bounded
# one-connection Supabase transaction-pooler configuration above.
RLS_TRANSACTION_MAX_WAIT_MS=15000

# Separate high-entropy credential for first-owner organization provisioning.
# Keep this route behind network controls in production and rotate regularly.
PLATFORM_PROVISIONING_SECRET="replace-with-at-least-32-random-characters"

# Optional comma-separated IP allowlist for the provisioning route, e.g.
# "203.0.113.10,203.0.113.11". Defense-in-depth only — relies on accurate
# req.ip, so only meaningful if the app trusts a correctly configured proxy
# in front of it. Leave unset to rely entirely on infrastructure-level
# network controls (security groups, ALB rules, etc.).
PLATFORM_PROVISIONING_ALLOWED_IPS=""

# Rate limit for the provisioning route. Defaults to 5 requests per 15
# minutes per client IP if unset.
PLATFORM_PROVISIONING_RATE_LIMIT_WINDOW_MS=900000
PLATFORM_PROVISIONING_RATE_LIMIT_MAX=5

# Optional in-process scheduler for the supplier price sync job (see
# modules/supplier-integration/worker.ts). Both must be set for the
# scheduler to start — leave either unset to no-op and instead run
# `npm run jobs:supplier-price-sync` from external cron / a k8s CronJob.
# Standard 5-field cron expression, e.g. "0 * * * *" for hourly.
SUPPLIER_PRICE_SYNC_CRON_SCHEDULE=""
# JSON array of { orgId, userId, supplierId, label? } — one entry per
# org/supplier to sync. userId must be an existing user with an active
# membership in orgId; the job runs as that identity. There is no
# cross-tenant service-account concept in this app, so targets must be
# listed explicitly rather than auto-discovered.
# Example: '[{"orgId":"...","userId":"...","supplierId":"...","label":"Acme"}]'
SUPPLIER_PRICE_SYNC_JOBS=""
# JSON object mapping supplier UUIDs to operator-approved HTTPS JSON feed
# endpoints. URLs are configuration-only and are never accepted from request
# bodies or the Supplier.website field. The feed must return:
# {"quotes":[{"materialId":"<uuid>","proposedUnitCost":12.34}]}
# If the Supplier has apiIntegrationKey set, the worker sends it as a Bearer
# token. Retrieved prices still enter the existing review queue and never
# mutate Material prices until an owner/admin explicitly approves them.
# Example: '{"11111111-1111-1111-1111-111111111111":"https://supplier.example/api/tradeos/prices"}'
SUPPLIER_PRICE_FEED_ENDPOINTS=""

# Project Athena A1 kernel (app/modules/athena-kernel). Ships dark by
# default - see docs/athena/roadmap/A1-ai-kernel-implementation-plan.md
# "Feature Flags". Do not enable ATHENA_KERNEL_ENABLED in production until
# the A1 exit criteria in that plan are met.
ATHENA_KERNEL_ENABLED="false"
# "fake" enables the deterministic, non-network FakeAthenaProvider used in
# tests/local dev. Any other value (including unset) keeps the provider
# disabled, so no real model call can happen without explicit configuration.
ATHENA_PROVIDER_MODE=""
ATHENA_DRAFT_RESPONSES_ENABLED="false"
ATHENA_TELEMETRY_ENABLED="true"
ATHENA_COST_TRACKING_ENABLED="true"
# A5 router/planner orchestration (docs/athena/roadmap/
# A5-router-planner-implementation-plan.md). Independent of
# ATHENA_KERNEL_ENABLED - the live HTTP path is already gated by that flag;
# this only controls whether the already-gated path uses A5's real
# routing/planning/live-context orchestration or A1's original stand-ins.
# Ships dark by default.
ATHENA_ROUTER_PLANNER_ENABLED="false"
# Kernel-owned request/provider deadlines in milliseconds (not derived from
# RLS_TRANSACTION_TIMEOUT_MS - see docs/athena/reviews/A1-parallel-readiness-review.md HIGH-P1/HIGH-P5).
ATHENA_REQUEST_DEADLINE_MS=15000
ATHENA_PROVIDER_DEADLINE_MS=8000
# Cap on needs_clarification/degraded round trips per execution before the
# kernel forces failed/cancelled.
ATHENA_MAX_LIFECYCLE_ROUND_TRIPS=2
